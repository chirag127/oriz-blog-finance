---
/*
 * finance-blog Footer — "Compound" ledger surface.
 *
 * Signature element: a serif pull-quote (Fraunces) with a gold quote mark —
 * the only place the footer raises its voice. Everything else stays quiet:
 * mono column headings, mono tag links, hairline rules.
 *
 * Reads palette + type from the "Compounding" tokens (tokens.css / global.css).
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = [
  { name: 'All categories', slug: '' },
  ...(await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
    name: category,
    slug: slugifyTag(category),
  })),
]
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-strip" aria-hidden="true">
    <span class="bf-strip-live"><span class="bf-strip-dot"></span>COMPOUND//TERMINAL</span>
    <span class="bf-strip-motto">// time in the market beats timing the market — start small, stay in</span>
  </div>
  <div class="bf-grid">
    <div class="bf-col">
      <h3 class="bf-h">Sectors</h3>
      <ul>
        {categories.map((c) => <li><a href={c.slug ? `/categories/${c.slug}/` : '/categories/'}>{c.name}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Desk</h3>
      <ul>
        <li><a href="/blog/">Blotter</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/series/">Positions</a></li>
        <li><a href="/now/">Now</a></li>
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Tags</h3>
      <ul class="bf-tags">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h">Feeds</h3>
      <ul>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/about/">The desk</a></li>
      </ul>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-finance"
    appName="Compound Terminal"
    bio="A working money desk for Indian investors and savers — by Chirag Singhal. Educational, not investment advice."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    margin-top: 5rem;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 1px solid var(--color-rule, var(--rule));
    font-family: var(--font-mono, ui-monospace);
  }
  .bf-strip {
    max-width: 1200px; margin: 0 auto;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem;
    padding: 18px 16px;
    border-bottom: 1px solid var(--color-rule, var(--rule));
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .bf-strip-live { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--brand, #0f6b4f); font-weight: 600; }
  .bf-strip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand, #0f6b4f); }
  .bf-strip-motto { color: var(--color-ink-mute, var(--ink-mute)); text-transform: none; letter-spacing: 0.02em; font-size: 11px; }
  .bf-grid {
    max-width: 1200px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 24px;
    padding: 24px 16px;
  }
  .bf-h {
    margin: 0 0 14px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute)); font-weight: 600;
  }
  .bf-h::before { content: '// '; color: var(--gold, #c6952a); }
  .bf-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .bf-col a { color: var(--color-ink, var(--ink)); font-size: 13px; text-decoration: none; }
  .bf-col a:hover { color: var(--color-accent, var(--brand, #0f6b4f)); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bf-tags { flex-direction: row; flex-wrap: wrap; gap: 8px 12px; }
  .bf-tags a { font-family: var(--font-mono, ui-monospace); font-size: 12px; color: var(--color-ink-mute, var(--ink-mute)); }
  .bf-tags a:hover { color: var(--color-accent, var(--brand, #0f6b4f)); text-decoration: none; }
  @media (min-width: 768px) { .bf-grid { grid-template-columns: 1fr 1fr; gap: 32px; padding: 28px 24px; } }
  @media (min-width: 1024px) { .bf-grid { grid-template-columns: repeat(4, 1fr); padding: 32px 24px; } }
</style>
