---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — TERMINAL status bar (not a magazine masthead).
 *
 *   ┌───────────────────────────────────────────────────────────────────────┐
 *   │ ▚ COMPOUND//TERMINAL  · SESSION OPEN   [scrolling desk ticker …]  ⌘K … │
 *   └───────────────────────────────────────────────────────────────────────┘
 *
 * A single 44px monospace status strip: brand glyph + session light on the
 * left, a marquee of the latest notes rendered as ticker symbols in the
 * middle, search (⌘K) + controls on the right. No centered LATEST/SERIES/TAGS
 * nav row — routing lives in the persistent right rail + the ticker itself.
 */
import { getPublishedPosts, postVertical, readingTimeFor } from '~/lib/blog'

const posts = await getPublishedPosts()
// Ticker symbols — derive a 3-4 char desk code from each recent note.
const deskCode: Record<string, string> = {
  dev: 'INV',
  finance: 'MKT',
  culture: 'SAV',
  health: 'CRD',
  personal: 'GEN',
}
const ticker = posts.slice(0, 10).map((p) => {
  const v = postVertical(p)
  const rt = (p.data.readingTime ?? readingTimeFor(p)).replace(/[^0-9]/g, '') || '—'
  return { code: deskCode[v] ?? 'GEN', v, rt, href: `/blog/${p.id}`, title: p.data.title }
})
// duplicate once so the marquee loops seamlessly
const tape = [...ticker, ...ticker]
---

<StatusBanner />
<header class="term-bar" transition:persist="site-header">
  <a class="term-brand" href="/" aria-label="Compound Terminal — home">
    <span class="term-glyph" aria-hidden="true">▚</span>
    <span class="term-name">COMPOUND<span class="term-slash">//</span>TERMINAL</span>
    <span class="term-session" aria-hidden="true"><span class="term-dot"></span>OPEN</span>
  </a>

  <div class="term-tape" aria-hidden="true">
    <div class="term-tape-track">
      {tape.map((t) => (
        <a class="tk" href={t.href} data-v={t.v} tabindex="-1">
          <span class="tk-code">{t.code}</span>
          <span class="tk-title">{t.title}</span>
          <span class="tk-rt">{t.rt}m</span>
        </a>
      ))}
    </div>
  </div>

  <div class="term-right">
    <div class="term-search"><MultiSearch client:idle /></div>
    <div class="term-controls"><HeaderControls client:idle /></div>
  </div>
</header>

<style>
  .term-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: stretch;
    height: 44px;
    background: color-mix(in oklab, var(--paper-2) 96%, var(--ink));
    border-bottom: 1px solid var(--rule-strong, var(--rule));
    font-family: var(--font-mono);
  }
  .term-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.875rem;
    text-decoration: none;
    color: var(--ink);
    border-right: 1px solid var(--rule);
    flex: 0 0 auto;
  }
  .term-glyph { color: var(--gold); font-size: 14px; line-height: 1; }
  .term-name {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .term-slash { color: var(--brand); }
  .term-session {
    display: none;
    align-items: center;
    gap: 0.3rem;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--brand);
    padding-left: 0.5rem;
    border-left: 1px solid var(--rule);
  }
  .term-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--brand) 60%, transparent);
    animation: term-pulse 2.4s var(--ease-out, ease-out) infinite;
  }
  @keyframes term-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--brand) 55%, transparent); }
    70% { box-shadow: 0 0 0 5px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  /* ── the ticker tape ─────────────────────────────────────────────── */
  .term-tape {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    display: none;
    align-items: center;
    border-right: 1px solid var(--rule);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .term-tape-track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: tape-scroll 60s linear infinite;
  }
  @keyframes tape-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .term-tape:hover .term-tape-track { animation-play-state: paused; }
  .tk {
    --v: var(--v-personal);
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-inline: 0.875rem;
    border-right: 1px solid color-mix(in oklab, var(--rule) 55%, transparent);
    text-decoration: none;
    color: var(--ink-mute);
    font-size: 11px;
  }
  .tk[data-v='dev'] { --v: var(--v-dev); }
  .tk[data-v='finance'] { --v: var(--v-finance); }
  .tk[data-v='culture'] { --v: var(--v-culture); }
  .tk[data-v='health'] { --v: var(--v-health); }
  .tk-code { color: var(--v); font-weight: 600; letter-spacing: 0.06em; }
  .tk-title {
    color: var(--ink);
    max-width: 26ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tk-rt { color: var(--ink-mute); font-size: 10px; }

  /* ── right controls ──────────────────────────────────────────────── */
  .term-right {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.625rem;
    margin-left: auto;
  }
  .term-search, .term-controls { display: inline-flex; align-items: center; }

  @media (min-width: 700px) {
    .term-session { display: inline-flex; }
    .term-tape { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-tape-track { animation: none; }
    .term-dot { animation: none; }
  }
</style>
