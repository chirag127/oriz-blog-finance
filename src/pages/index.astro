---
/**
 * /  — COMPOUND//TERMINAL front page.
 *
 * TERMINAL / DATA-DASHBOARD archetype: a "SESSION OPEN" panel (the signature
 * compounding curve reframed as a live-desk readout with a stat strip), then a
 * dense monospace BLOTTER — every note a fill row: [DATE] DESK │ headline │ RT.
 * The persistent right WATCHLIST rail (positions / sectors / fill log) comes
 * from BaseLayout, so the homepage no longer repeats series/category strata.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const blotter = allPosts.slice(0, 24)

const seriesCount = (await getSeriesWithCounts()).length
const catCount = (await getCategoriesWithCounts()).length

// Desk codes mirror the header ticker.
const deskCode: Record<string, string> = {
  dev: 'INV',
  finance: 'MKT',
  culture: 'SAV',
  health: 'CRD',
  personal: 'GEN',
}

const now = new Date()
const stamp = now.toISOString().slice(0, 10)
const clock = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })
const yearsRunning = now.getFullYear() - 2019

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="COMPOUND · finance terminal"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
>
  <div class="term-page">
    {/* ── SESSION panel — the thesis, as a live desk readout ─────────── */}
    <section class="session" aria-label="Compound — session open">
      <header class="session-bar">
        <span class="sb-live"><span class="sb-dot" aria-hidden="true"></span>SESSION OPEN</span>
        <span class="sb-stamp">{stamp} · {clock} IST</span>
      </header>

      <div class="session-body">
        <div class="session-copy">
          <h1 class="thesis">Money, compounded.</h1>
          <p class="thesis-sub">A working desk for Indian investors and savers. Index funds, credit reports, tax, the first emergency fund — logged plainly, no sales pitch.</p>
          <p class="thesis-cta">
            <a href="/blog/" class="tbtn">Open blotter</a>
            <a href="/about/" class="tbtn tbtn-ghost">The desk</a>
          </p>
        </div>

        <figure class="curve" aria-label="A compounding growth curve rising from left to right, with milestone markers.">
          <svg class="curve-svg" viewBox="0 0 420 220" preserveAspectRatio="none" role="img" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="curveFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--gold)" stop-opacity="0.2" />
                <stop offset="100%" stop-color="var(--gold)" stop-opacity="0" />
              </linearGradient>
            </defs>
            <g class="curve-grid">
              <line x1="0" y1="55" x2="420" y2="55" />
              <line x1="0" y1="110" x2="420" y2="110" />
              <line x1="0" y1="165" x2="420" y2="165" />
            </g>
            <path class="curve-area" d="M8 206 C 120 202, 210 178, 288 124 C 344 86, 380 46, 412 14 L 412 214 L 8 214 Z" />
            <path class="curve-line" d="M8 206 C 120 202, 210 178, 288 124 C 344 86, 380 46, 412 14" />
            <circle class="curve-dot" cx="8" cy="206" r="4" />
            <circle class="curve-dot" cx="150" cy="192" r="4" />
            <circle class="curve-dot" cx="288" cy="124" r="4.5" />
            <circle class="curve-dot curve-dot-end" cx="412" cy="14" r="6" />
          </svg>
          <figcaption class="curve-cap">₹1 invested · grows while you sleep</figcaption>
        </figure>
      </div>

      <dl class="stats">
        <div class="stat"><dt>Notes</dt><dd>{allPosts.length}</dd></div>
        <div class="stat"><dt>Series</dt><dd>{seriesCount}</dd></div>
        <div class="stat"><dt>Desks</dt><dd>{catCount}</dd></div>
        <div class="stat"><dt>Running</dt><dd>{yearsRunning}y</dd></div>
      </dl>
    </section>

    {/* ── BLOTTER — dense fill rows ──────────────────────────────────── */}
    <section class="blotter" aria-labelledby="blotter-h">
      <header class="blotter-head">
        <h2 id="blotter-h" class="blotter-title">Blotter</h2>
        <span class="blotter-cols" aria-hidden="true">
          <span>DATE</span><span>DESK</span><span>NOTE</span><span>RT</span>
        </span>
      </header>
      <ol class="rows">
        {blotter.map((p, i) => {
          const v = postVertical(p)
          const rt = (p.data.readingTime ?? readingTimeFor(p)).replace(/[^0-9]/g, '') || '—'
          return (
            <li class:list={['row', i === 0 && 'row-lead']} data-v={v}>
              <a class="row-link" href={`/blog/${p.id}`}>
                <time class="row-date" datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                <span class="row-desk">{deskCode[v] ?? 'GEN'}</span>
                <span class="row-body">
                  <span class="row-title">{p.data.title}</span>
                  {i === 0 && <span class="row-dek">{p.data.description}</span>}
                  <span class="row-desklabel">{verticalLabel(v)}</span>
                </span>
                <span class="row-rt">{rt}m</span>
              </a>
            </li>
          )
        })}
      </ol>
      <a class="blotter-all" href="/archive/">full archive · {allPosts.length} notes →</a>
    </section>
  </div>
</BaseLayout>

<style>
  .term-page {
    padding: 0 clamp(0.875rem, 2.5vw, 1.5rem) 3rem;
    font-family: var(--font-mono);
  }

  /* ── SESSION panel ──────────────────────────────────────────────── */
  .session {
    border: 1px solid var(--rule-strong, var(--rule));
    background: var(--paper-2);
    margin-top: 1rem;
  }
  .session-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--rule);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .sb-live { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--brand); font-weight: 600; }
  .sb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); animation: sess-pulse 2.4s var(--ease-out, ease-out) infinite; }
  @keyframes sess-pulse { 0% { opacity: 1; } 50% { opacity: 0.35; } 100% { opacity: 1; } }
  .sb-stamp { font-size: 10px; color: var(--ink-mute); }

  .session-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding: clamp(1.25rem, 3vw, 2rem) 0.875rem;
  }
  @media (max-width: 720px) { .session-body { grid-template-columns: 1fr; } }
  .thesis {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    color: var(--ink);
    margin: 0;
    max-width: 12ch;
  }
  .thesis-sub {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.4vw, 1.0625rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1rem 0 0;
    max-width: 46ch;
  }
  .thesis-cta { display: flex; flex-wrap: wrap; gap: 0.625rem; margin: 1.5rem 0 0; }
  .tbtn {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.55rem 1rem;
    background: var(--accent); color: var(--color-accent-fg, #fff);
    text-decoration: none;
    transition: transform var(--dur-fast, 120ms) ease;
  }
  .tbtn:hover { transform: translateY(-1px); }
  .tbtn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule-strong, var(--rule)); }
  .tbtn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  .curve { margin: 0; border: 1px solid var(--rule); background: var(--paper); padding: 0.75rem 0.75rem 0.5rem; }
  .curve-svg { display: block; width: 100%; height: auto; aspect-ratio: 420 / 220; }
  .curve-grid line { stroke: var(--rule); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .curve-area { fill: url(#curveFill); }
  .curve-line {
    fill: none; stroke: var(--gold); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 720; stroke-dashoffset: 720;
    animation: curve-draw 1600ms var(--ease-out, ease-out) 200ms forwards;
  }
  .curve-dot { fill: var(--gold); opacity: 0; animation: curve-pop 300ms var(--ease-out, ease-out) forwards; }
  .curve-dot:nth-of-type(1) { animation-delay: 400ms; }
  .curve-dot:nth-of-type(2) { animation-delay: 900ms; }
  .curve-dot:nth-of-type(3) { animation-delay: 1400ms; }
  .curve-dot-end { stroke: var(--paper); stroke-width: 3; animation-delay: 1750ms; }
  @keyframes curve-draw { to { stroke-dashoffset: 0; } }
  @keyframes curve-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: scale(1); } }
  .curve-cap { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-mute); margin-top: 0.5rem; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--rule);
  }
  .stat { padding: 0.75rem 0.875rem; border-right: 1px solid var(--rule); }
  .stat:last-child { border-right: 0; }
  .stat dt { font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute); margin: 0; }
  .stat dd { margin: 0.2rem 0 0; font-size: 1.25rem; font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }

  /* ── BLOTTER ────────────────────────────────────────────────────── */
  .blotter { margin-top: 1.75rem; }
  .blotter-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 0.5rem; border-bottom: 2px solid var(--accent);
  }
  .blotter-title {
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 600; color: var(--ink-mute); margin: 0;
  }
  .blotter-cols {
    display: none;
    font-size: 9px; letter-spacing: 0.14em; color: var(--ink-mute);
    grid-template-columns: 92px 44px minmax(0, 1fr) 40px; gap: 0.75rem;
  }
  @media (min-width: 720px) { .blotter-cols { display: grid; } }

  .rows { list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .row {
    --v: var(--v-personal);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 72%, transparent);
  }
  .row[data-v='dev'] { --v: var(--v-dev); }
  .row[data-v='finance'] { --v: var(--v-finance); }
  .row[data-v='culture'] { --v: var(--v-culture); }
  .row[data-v='health'] { --v: var(--v-health); }
  .row-link {
    display: grid;
    grid-template-columns: 92px 44px minmax(0, 1fr) 40px;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.55rem 0.5rem 0.55rem 0.75rem;
    margin-left: -0.75rem;
    border-left: 2px solid transparent;
    text-decoration: none; color: var(--ink);
    transition: border-color var(--dur-fast, 120ms) ease, background var(--dur-fast, 120ms) ease;
  }
  .row-link:hover { border-left-color: var(--v); background: color-mix(in oklab, var(--paper-2) 60%, transparent); }
  .row-link:hover .row-title { color: var(--accent); }
  .row-date { font-size: 11px; color: var(--ink-mute); font-variant-numeric: tabular-nums; }
  .row-desk { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; color: var(--v); }
  .row-body { min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .row-title { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; color: var(--ink); }
  .row-dek { font-family: var(--font-body); font-size: 14px; line-height: 1.5; color: var(--ink-mute); margin-top: 0.15rem; max-width: 60ch; }
  .row-desklabel { display: none; font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--v); margin-top: 0.15rem; }
  .row-rt { font-size: 11px; color: var(--ink-mute); text-align: right; white-space: nowrap; }
  .row-lead .row-link { padding-top: 0.875rem; padding-bottom: 0.875rem; }

  @media (max-width: 719px) {
    .row-link {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'date rt' 'body body';
      row-gap: 0.25rem;
    }
    .row-date { grid-area: date; }
    .row-rt { grid-area: rt; }
    .row-desk { display: none; }
    .row-body { grid-area: body; }
    .row-desklabel { display: inline-block; }
  }

  .blotter-all { display: inline-block; margin-top: 1rem; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); text-decoration: none; }
  .blotter-all:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .curve-line { animation: none; stroke-dashoffset: 0; }
    .curve-dot { animation: none; opacity: 1; }
    .sb-dot { animation: none; }
  }
</style>
